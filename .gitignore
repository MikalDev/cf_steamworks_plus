# Ignore node_modules
node_modules/

# Ignore all files in the dist directory
/dist/*

# Ignore all files in the export directory
/export/*

# Ignore all files in the steamworks-sdk directory
/wrapper-extension/steamworks-sdk/*

/construct-plugin/*.dll
/construct-plugin/*.exp
/construct-plugin/*.lib
/construct-plugin/*.pdb

/wrapper-extension/.vs

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

*.tlog
*.obj
*.pch
*.ilk

*.c3addon
*.vcxproj.user
wrapper-extension/steamworks-sdk/
wrapper-extension/x64/
wrapper-extension/SteamExt/x64/
wrapper-extension/Win32/
construct-plugin/*.exp
construct-plugin/*.lib
construct-plugin/*.pdb

# Ignore CMake build directories
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Ignore build directories
/build/
/out/

# Ignore CMake generated files
*.cmake
*.cbp
*.sln
*.vcxproj
*.vcxproj.filters
*.user
*.ninja
*.ninja_deps
*.ninja_log
*.dir/

# Ignore CMake generated executables and libraries
*.exe
*.dll
*.lib
*.a
*.so
*.dylib
*.app

# Ignore vcpkg installed libraries and build directories
vcpkg_installed/
vcpkg/buildtrees/
vcpkg/downloads/
vcpkg/packages/
vcpkg/ports/.*/build


